# ===== Django (bắt buộc) =====
# Tạo khóa ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ===== Bảo mật khi DEBUG=False (tùy chọn, chỉ bật khi chạy HTTPS) =====
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# ===== Tài khoản demo (dùng cho: python manage.py create_demo_accounts) =====
# Để trống -> hệ thống sinh mật khẩu ngẫu nhiên và in ra màn hình một lần
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_PASSWORD=

# ===== Email =====
# Môi trường dev: in email ra console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Gmail SMTP: đổi EMAIL_BACKEND thành django.core.mail.backends.smtp.EmailBackend và điền App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=iParts Store <no-reply@iparts.local>

# ===== Google OAuth (django-allauth) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Google Gemini (iParts AI Assistant) =====
# Để trống -> chatbot chạy chế độ cơ bản (dự phòng), vẫn dùng dữ liệu thật từ DB
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20

# ===== VNPay Sandbox =====
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:8000/thanh-toan/vnpay/return/

# ===== MoMo Sandbox =====
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://127.0.0.1:8000/thanh-toan/momo/return/
MOMO_IPN_URL=http://127.0.0.1:8000/thanh-toan/momo/ipn/
